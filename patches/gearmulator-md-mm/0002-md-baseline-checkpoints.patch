+	void advanceFrames(md::Hardware& _hardware, const uint32_t _frameCount)
+	{
+		constexpr uint32_t blockSize = 128;
+		for(uint32_t frame = 0; frame < _frameCount; frame += blockSize)
+			_hardware.advance(std::min(blockSize, _frameCount - frame));
+	}
+
 	void advance(md::Hardware& _hardware, const uint32_t _seconds)
 	{
+		advanceFrames(_hardware, md::g_samplerate * _seconds);
+	}
+
+	void printCheckpoint(const char* const _name, const char* const _initialState,
+		md::Hardware& _hardware, const uint32_t _frames)
+	{
+		const auto panel = _hardware.getFrontPanelSnapshot();
+		std::cout << "MDCP schema=1 checkpoint=" << _name
+			<< " initial_state=" << _initialState
+			<< " frames=" << _frames
+			<< " pc_register=" << _hardware.getUC().getPC()
+			<< " sp_register=" << _hardware.getUC().getAReg(7)
+			<< " host_cycles=" << _hardware.hostCurrentCycle()
+			<< " mcu_cycles=" << _hardware.getUC().getCycles()
+			<< " dsp1_cycles=" << _hardware.getDspMixer().dsp().getCycles()
+			<< " dsp2_cycles=" << _hardware.getDspProducer().dsp().getCycles()
+			<< " dsp1_booted=" << _hardware.getDspMixer().booted()
+			<< " dsp2_booted=" << _hardware.getDspProducer().booted()
+			<< " panel_handshake=" << _hardware.getUC().isPanelHandshakeComplete()
+			<< " midi_ready=" << _hardware.isFirmwareMidiReady()
+			<< " panel_bytes=" << panel.getByteCount()
+			<< " panel_tiles=" << panel.getTileWriteCount()
+			<< " panel_lit_pixels=" << panel.countLitPixels()
+			<< " factory_cache_ready=" << _hardware.isFactoryFlashCacheReady()
+			<< " factory_init_expected=" << _hardware.isFactoryFlashInitializationExpected()
+			<< " flash_dirty=" << _hardware.flashDirty() << '\n';
+	}
+
+	int setEnvironmentVariable(const char* const _name, const char* const _value)
+	{
+#ifdef _WIN32
+		return _putenv_s(_name, _value);
+#else
+		return setenv(_name, _value, 1);
+#endif
+	}
+
+	void setTraceCaptureEnabled(const bool _enabled)
+	{
+		if(std::getenv("GEARMULATOR_MD_BUS_TRACE") == nullptr)
+			return;
+		if(setEnvironmentVariable("GEARMULATOR_MD_BUS_TRACE_ENABLED", _enabled ? "1" : "0") != 0)
+			throw std::runtime_error("could not change trace capture state");
+	}
+
+	void setTraceInstanceLabel(const char* const _label)
+	{
+		if(std::getenv("GEARMULATOR_MD_BUS_TRACE") == nullptr)
+			return;
+		if(setEnvironmentVariable("GEARMULATOR_MD_TRACE_INSTANCE_LABEL", _label) != 0)
+			throw std::runtime_error("could not set trace instance label");
+	}
