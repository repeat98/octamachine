+		const uint32_t maximumFrames = md::g_samplerate * _maximumSeconds;
+		uint32_t advancedFrames = 0;
+		bool dsp1Reported = false;
+		bool dsp2Reported = false;
+		while(advancedFrames < maximumFrames)
+		{
+			const auto count = std::min(blockSize, maximumFrames - advancedFrames);
+			_hardware.advance(count);
+			advancedFrames += count;
+			if(!dsp1Reported && _hardware.getDspMixer().booted())
+			{
+				printCheckpoint(_dsp1Checkpoint, _initialState, _hardware, advancedFrames);
+				dsp1Reported = true;
+			}
+			if(!dsp2Reported && _hardware.getDspProducer().booted())
+			{
+				printCheckpoint(_dsp2Checkpoint, _initialState, _hardware, advancedFrames);
+				dsp2Reported = true;
+			}
+			if(_hardware.isFirmwareMidiReady())
+			{
+				printCheckpoint(_readyCheckpoint, _initialState, _hardware, advancedFrames);
+				setTraceCaptureEnabled(false);
+				return advancedFrames;
+			}
+		}
+		throw std::runtime_error(std::string(_readyCheckpoint)
+			+ ": firmware readiness did not arrive within the bounded frame window");
 	}
 
