+			static const char* const path = std::getenv("GEARMULATOR_MD_BUS_TRACE");
+			static FILE* const trace = []
+			{
+				if(!path || !*path)
+					return static_cast<FILE*>(nullptr);
+				auto* const file = std::fopen(path, "w");
