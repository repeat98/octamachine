+			static unsigned limit = []
+			{
+				const char* const value = std::getenv("GEARMULATOR_MD_BUS_TRACE_LIMIT");
+				if(!value || !*value)
+					return 100000u;
+				const auto parsed = std::strtoul(value, nullptr, 10);
+				return parsed == 0 ? 100000u : static_cast<unsigned>(parsed);
+			}();
+			static unsigned count = 0;
+			if(count >= limit)
+			{
+				if(count == limit)
+				{
+					std::fputs("mdbus trace truncated at configured event limit\n", trace);
+					std::fflush(trace);
+					++count;
+				}
+				return;
+			}
+			std::fprintf(trace, "mdbus cycle=%llu pc=%08x %c%u addr=%08x value=%08x\n",
+				static_cast<unsigned long long>(_uc.getCycles()), _uc.getPC(),
+				_write ? 'W' : 'R', static_cast<unsigned>(_size), _address, _value);
+			++count;
+		}
 	}
 
