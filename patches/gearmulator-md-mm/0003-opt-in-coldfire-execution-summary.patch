+
+		void record(m68ki_cpu_core* const cpu)
+		{
+			if(!file || instructions >= instructionLimit)
+				return;
+			++instructions;
+			const auto pc = m68k_get_reg(cpu, M68K_REG_PC);
+			const auto opcode = static_cast<uint16_t>(m68k_read_memory_16(cpu, pc));
+			const char* kind = nullptr;
+			size_t index = 0;
+			if(opcode == 0x4e7a || opcode == 0x4e7b) { kind = "MOVEC"; index = 0; }
+			else if(opcode == 0x4e73) { kind = "RTE"; index = 1; }
+			else if((opcode & 0xfff0) == 0x4e40) { kind = "TRAP"; index = 2; }
+			else if(opcode == 0x4e70) { kind = "RESET"; index = 3; }
+			else if(opcode == 0x4e72) { kind = "STOP"; index = 4; }
+			else if((opcode & 0xffc0) == 0x46c0 || opcode == 0x46fc) { kind = "MOVE_TO_SR"; index = 5; }
+			else if((opcode & 0xffc0) == 0x40c0) { kind = "MOVE_FROM_SR"; index = 6; }
+			else if(opcode == 0x003c || opcode == 0x007c || opcode == 0x023c
+				|| opcode == 0x027c || opcode == 0x0a3c || opcode == 0x0a7c)
+			{ kind = "CCR_OR_SR_IMMEDIATE"; index = 7; }
+			else if((opcode & 0xfff0) == 0x4e60) { kind = "USP_STACK"; index = 8; }
+			if(kind)
+			{
+				++counts[index];
+				if(opcode == 0x4e7a || opcode == 0x4e7b)
+				{
+					if(opcode == 0x4e7b)
+						++movecTo;
+					else
+						++movecFrom;
+					const auto control = m68k_read_memory_16(cpu, pc + 2) & 0x0fff;
+					size_t controlIndex = 6;
+					switch(control)
+					{
+						case 0x801: controlIndex = 0; break;
+						case 0x002: controlIndex = 1; break;
+						case 0x004: controlIndex = 2; break;
+						case 0x005: controlIndex = 3; break;
+						case 0xc04: controlIndex = 4; break;
+						case 0xc0f: controlIndex = 5; break;
+						default: break;
+					}
+					if(opcode == 0x4e7b)
+						++controlWrites[controlIndex];
+				}
+			}
+		}
+	};
