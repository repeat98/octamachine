+				static_cast<unsigned long long>(counts[7]),
+				static_cast<unsigned long long>(counts[8]),
+				static_cast<unsigned long long>(controlWrites[0]),
+				static_cast<unsigned long long>(controlWrites[1]),
+				static_cast<unsigned long long>(controlWrites[2]),
+				static_cast<unsigned long long>(controlWrites[3]),
