--- a/src/board/ot-board.c
+++ b/src/board/ot-board.c
@@ -48,6 +48,17 @@
 #include "ot-audio-shm.h"
 
 #define OT_SDRAM_BASE   0x40000000
+/* The part is 128 MiB; SDCS0 = 0x4000001b decodes 256 MiB over it, so
+ * 0x48000000..0x4fffffff is THE SAME memory a second time. CACR's
+ * DDCM_P makes the default data mode cache-inhibited and ACR0 =
+ * 0x4007e020 covers only the lower 128 MiB copyback, so the high
+ * decode is how the firmware (and every octabam loader) writes
+ * UNCACHED: stage, depack and the stock boot memset of the delay
+ * rings all name 0x4f... for memory that is read back at 0x47....
+ * Mapping 256 MiB of flat RAM here instead made the two halves
+ * separate memory: an octabam DRAM runtime depacked to 0x48a955e0
+ * and every detour into it read zeros at 0x40a955e0. */
+#define OT_SDRAM_ALIAS  0x48000000
 #define OT_IMAGE_LOAD   0x40000400
 #define OT_INIT_SP      0x47F00000
 #define OT_LOWRAM_SIZE  0x00010000
@@ -2180,6 +2191,10 @@ static uint32_t ot_atap_produced;
 #define OT_SCRATCH_HI   0x4ec94a00u
 #define OT_SCRATCH_POISON 0xa5c3a5c3u   /* not 0, not a valid pointer */
 
+/* NB since the uncached decode became an alias of the part: this range is
+ * the LOW 115 MB of SDRAM seen through OT_SDRAM_ALIAS, not a region of
+ * its own. It runs before the reset path loads the OS image, so the
+ * image still lands on top of the poison. */
 static void ot_scratch_poison(void)
 {
     uint32_t buf[1024];
@@ -2435,6 +2450,13 @@ static void octatrack_init(MachineState *machine)
     env->vbr = 0;
 
     memory_region_add_subregion(sysmem, OT_SDRAM_BASE, machine->ram);
+    {
+        MemoryRegion *uncached = g_new(MemoryRegion, 1);
+
+        memory_region_init_alias(uncached, NULL, "octatrack.ram.uncached",
+                                 machine->ram, 0, machine->ram_size);
+        memory_region_add_subregion(sysmem, OT_SDRAM_ALIAS, uncached);
+    }
     memory_region_init_ram(lowram, NULL, "octatrack.lowram",
                            OT_LOWRAM_SIZE, &error_fatal);
     memory_region_add_subregion(sysmem, 0, lowram);
@@ -2791,8 +2813,11 @@ static void octatrack_machine_class_init(ObjectClass *oc, const void *data)
     mc->init = octatrack_init;
     mc->default_cpu_type = M68K_CPU_TYPE_NAME("cfv4e");
     mc->default_ram_id = "octatrack.ram";
-    /* 256 MiB: the storage buffers span up to 244.7 MB above the SDRAM base. */
-    mc->default_ram_size = 256 * MiB;
+    /* 128 MiB, the size of the part. The storage buffers that appear to
+     * span up to 244.7 MB above the SDRAM base are the same memory seen
+     * through the uncached decode at OT_SDRAM_ALIAS, which
+     * octatrack_init() maps as an alias of this RAM. */
+    mc->default_ram_size = 128 * MiB;
 
     object_class_property_add_bool(oc, "mk1", ot_get_mk1, ot_set_mk1);
     object_class_property_set_description(oc, "mk1",
