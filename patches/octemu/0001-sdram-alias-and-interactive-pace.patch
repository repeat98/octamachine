+        if (parsed >= 1 && parsed <= 8) {
+            g_pace = (uint32_t)parsed;
+        }
+    }
     g_exitWithFrontend = exit_with_frontend != 0;
     g_interleave = interleave;
     /* A TB holds at most TCG_MAX_INSNS instructions and the budget is checked
